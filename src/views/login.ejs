<!DOCTYPE html>
<html>
  <head>
    <title>Đăng nhập</title>

    <link rel="stylesheet" href="/stylesheets/login.css" />
  </head>

  <body>
    <div class="login-container">
      <h2 class="login-title">Đăng nhập tài khoản</h2>

      <form action="/login" method="POST">
        <label>Email</label>
        <input class="login-input" type="email" name="email" required />

        <label>Password</label>
        <input class="login-input" type="password" name="password" required />

        <button class="login-btn" type="submit">Đăng nhập</button>
      </form>

      <p class="login-link">
        <a href="/register">Chưa có tài khoản? Đăng ký</a>
      </p>
    </div>
  </body>
</html>
